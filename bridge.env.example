# Bridge HTTP server (bound to localhost; exposed only through a tunnel).
OPENCODE_BRIDGE_HOST=127.0.0.1
OPENCODE_BRIDGE_PORT=8787
# Fall back to 8788, 8789, ... if the preferred port is taken.
OPENCODE_BRIDGE_AUTO_PORT=true

# Host headers accepted by the MCP endpoint. Supports exact hosts and *.suffix.
# Tunnel hostnames are registered automatically at runtime.
OPENCODE_BRIDGE_ALLOWED_HOSTS=127.0.0.1,localhost

# Required for any exposed endpoint. Clients send Authorization: Bearer <token>.
OPENCODE_BRIDGE_TOKEN=

# Off by default: query/path tokens leak into proxy and tunnel logs.
OPENCODE_BRIDGE_ALLOW_QUERY_TOKEN=false

# Colon-separated directories the bridge may read and drive. Keep this narrow.
# Note: opencode records a session's directory as where you launched it, not the
# repo you edited. Sessions started from ~ are only visible if ~ is listed.
OPENCODE_BRIDGE_ALLOWED_ROOTS=/Users/you/Projects

# Local-only by default. Set to cloudflare or tailscale for ChatGPT access.
OPENCODE_BRIDGE_TUNNEL=none
CLOUDFLARED_BIN=cloudflared
TAILSCALE_BIN=/Applications/Tailscale.app/Contents/MacOS/Tailscale

# Optional: drive the opencode background service that is already running on this
# machine instead of spawning a per-repo server. The service is what runs your
# live TUI sessions. Credentials are read from OPENCODE_BRIDGE_SERVICE_CONFIG.
OPENCODE_BRIDGE_USE_SERVICE=false
OPENCODE_BRIDGE_SERVICE_CONFIG=/Users/you/.local/state/opencode/service.json

# Model applied to sessions the bridge creates, as provider/model or provider/model#variant.
# Set this when the server default is not the model you want charged.
# OPENCODE_BRIDGE_DEFAULT_MODEL=opencode/minimax-m3.1-flash-free

# Optional: use an already-running opencode server instead of spawning one per repo.
# OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# When spawning opencode per repo.
OPENCODE_BIN=opencode
OPENCODE_BRIDGE_OPENCODE_HOST=127.0.0.1
OPENCODE_BRIDGE_OPENCODE_PORT_START=4096
